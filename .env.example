# PostgreSQL connection credentials for the CRM sales ETL
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=CRM_sale
PG_USER=postgres
PG_PASSWORD=your_password

# Source data folder containing CRM CSV/Excel exports
DATA_DIR=./data/raw
